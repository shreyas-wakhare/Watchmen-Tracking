<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- ============================================================
         WATCHMEN ELITE COMMAND CENTER THEME
         Source of Truth: Web Dashboard watchmen-elite.css
         Layered Dark Surfaces (#0B0F14, #10161D, #141B23, #18212B)
         ============================================================ -->
    <style name="Theme.DWEX" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Palette -->
        <item name="colorPrimary">@color/watchmen_primary</item>
        <item name="colorPrimaryVariant">@color/watchmen_primary_hover</item>
        <item name="colorOnPrimary">@color/text_white</item>
        
        <!-- Secondary / Accent -->
        <item name="colorSecondary">@color/watchmen_primary</item>
        <item name="colorSecondaryVariant">@color/watchmen_primary_hover</item>
        <item name="colorOnSecondary">@color/text_white</item>
        <item name="colorError">@color/watchmen_critical</item>
        <item name="colorOnError">@color/text_white</item>
        
        <!-- Surface & Window Backgrounds -->
        <item name="android:windowBackground">@color/watchmen_bg_primary</item>
        <item name="backgroundColor">@color/watchmen_bg_primary</item>
        <item name="colorSurface">@color/watchmen_bg_card</item>
        <item name="colorOnSurface">@color/watchmen_text_primary</item>
        <item name="colorSurfaceVariant">@color/watchmen_bg_elevated</item>
        <item name="colorOnSurfaceVariant">@color/watchmen_text_secondary</item>
        
        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/watchmen_bg_secondary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/watchmen_bg_primary</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        
        <!-- Text Appearances -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.DWEX.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.DWEX.Headline2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.DWEX.Body1</item>
        
        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.DWEX.Button</item>
        <item name="materialCardViewStyle">@style/Widget.DWEX.Card</item>
        <item name="textInputStyle">@style/Widget.DWEX.TextInputLayout</item>
    </style>
    
    <!-- Splash Theme (Dark Obsidian Command Center) -->
    <style name="Theme.DWEX.Splash" parent="Theme.DWEX">
        <item name="android:windowBackground">@drawable/splash_background_gradient</item>
        <item name="android:statusBarColor">@color/watchmen_bg_primary</item>
        <item name="android:navigationBarColor">@color/watchmen_bg_primary</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
        <item name="android:windowEnterTransition">@android:transition/fade</item>
    </style>
    
    <!-- Text Appearances -->
    <style name="TextAppearance.DWEX" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/watchmen_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.DWEX.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/watchmen_text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.DWEX.Headline2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/watchmen_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.DWEX.Body1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/watchmen_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.DWEX.SectionTitle" parent="TextAppearance.DWEX">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/watchmen_text_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.DWEX.Mono" parent="TextAppearance.DWEX">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/watchmen_text_secondary</item>
    </style>
    
    <!-- Button Styles (Derived from .btn-saas in watchmen-elite.css) -->
    <style name="Widget.DWEX.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/watchmen_primary</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/btn_height_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    
    <style name="Widget.DWEX.Button.Secondary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/watchmen_bg_elevated</item>
        <item name="strokeColor">@color/watchmen_border_default</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="android:textColor">@color/watchmen_text_primary</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/btn_height_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.DWEX.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/watchmen_critical</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/btn_height_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.DWEX.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/watchmen_border_default</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="android:textColor">@color/watchmen_text_primary</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/btn_height_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    
    <!-- Card Style (Derived from .saas-card in watchmen-elite.css) -->
    <style name="Widget.DWEX.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="strokeColor">@color/watchmen_border_default</item>
        <item name="cardBackgroundColor">@color/watchmen_bg_card</item>
    </style>

    <!-- TextInputLayout Style (Derived from .auth-input-wrapper and .form-input) -->
    <style name="Widget.DWEX.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/watchmen_border_default</item>
        <item name="boxStrokeWidth">@dimen/border_width</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">@color/watchmen_bg_input</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="hintTextColor">@color/watchmen_text_secondary</item>
        <item name="android:textColorHint">@color/watchmen_text_muted</item>
    </style>
    
</resources>
