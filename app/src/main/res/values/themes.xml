<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Main DWEX Professional Theme -->
    <style name="Theme.DWEX" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/dwex_blue</item>
        <item name="colorPrimaryVariant">@color/dwex_blue_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>
        
        <!-- Secondary/Accent Colors -->
        <item name="colorSecondary">@color/dwex_red</item>
        <item name="colorSecondaryVariant">@color/dwex_red_dark</item>
        <item name="colorOnSecondary">@color/text_white</item>
        
        <!-- Background -->
        <item name="android:windowBackground">@color/background_secondary</item>
        <item name="backgroundColor">@color/background_primary</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/dwex_blue_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/background_primary</item>
        
        <!-- Text Appearance -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.DWEX.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.DWEX.Headline2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.DWEX.Body1</item>
        
        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.DWEX.Button</item>
        <item name="materialCardViewStyle">@style/Widget.DWEX.Card</item>
    </style>
    
    <!-- Splash Theme (for loading screen) -->
    <style name="Theme.DWEX.Splash" parent="Theme.DWEX">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/dwex_blue</item>
        <item name="android:navigationBarColor">@color/dwex_blue</item>
<item name="android:windowActivityTransitions">true</item>
<item name="android:windowExitTransition">@android:transition/fade</item>
<item name="android:windowEnterTransition">@android:transition/fade</item>
    </style>
    
    <!-- Text Appearances -->
    <style name="TextAppearance.DWEX.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.DWEX.Headline2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.DWEX.Body1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <!-- Button Style -->
    <style name="Widget.DWEX.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/dwex_blue</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="Widget.DWEX.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/dwex_blue</item>
        <item name="android:textColor">@color/dwex_blue</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- Card Style -->
    <style name="Widget.DWEX.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>
    
</resources>
