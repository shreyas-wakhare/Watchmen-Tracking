<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:background="@color/watchmen_bg_card"
    android:padding="24dp">

    <!-- Graphic / Illustration -->
    <ImageView
        android:id="@+id/guidePageImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:src="@drawable/dwex_guide_intro"
        android:contentDescription="@null"
        android:scaleType="fitCenter"/>

    <!-- Title -->
    <TextView
        android:id="@+id/guidePageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/watchmen_text_primary"
        android:layout_marginBottom="12dp"/>

    <!-- Body -->
    <TextView
        android:id="@+id/guidePageBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/watchmen_text_secondary"
        android:lineSpacingExtra="6dp"
        android:fontFamily="sans-serif"/>

</LinearLayout>
