<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="locale"
    android:background="@color/watchmen_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:src="@drawable/logo_dwex_vector"
                android:scaleType="fitCenter"
                android:contentDescription="@string/dwex_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_title"
                android:textSize="22sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/watchmen_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configure field tracking and backend endpoint"
                android:textSize="13sp"
                android:textColor="@color/watchmen_text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Configuration Card Container -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.DWEX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_modal"
            app:strokeWidth="1dp"
            app:strokeColor="@color/watchmen_border_default"
            app:cardBackgroundColor="@color/watchmen_bg_card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Language Selector -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_language"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/languageSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_icon_container_elevated"
                    android:paddingHorizontal="12dp" />

                <!-- Device Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_name"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/device_name"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Supervisor Phone -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/supervisor_phone"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etSupervisorPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/supervisor_phone"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Project Number -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROJECT NUMBER"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etProjectNumber"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Project Number (e.g. PRJ-2026-A)"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Server URL / IP -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERVER BASE URL"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="http://192.168.1.53:8000"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Save Setup Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSetup"
                    style="@style/Widget.DWEX.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height_lg"
                    android:text="@string/save_setup"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_check_in"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Configuration can be modified later in Settings"
            android:textSize="12sp"
            android:textColor="@color/watchmen_text_muted"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
