<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="locale"
    android:background="@color/watchmen_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:src="@drawable/logo_dwex_vector"
                android:scaleType="fitCenter"
                android:contentDescription="@string/dwex_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_title"
                android:textSize="22sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/watchmen_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configure field tracking and backend endpoint"
                android:textSize="13sp"
                android:textColor="@color/watchmen_text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Configuration Card Container -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.DWEX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_modal"
            app:strokeWidth="1dp"
            app:strokeColor="@color/watchmen_border_default"
            app:cardBackgroundColor="@color/watchmen_bg_card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Language Selector -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_language"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/languageSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_icon_container_elevated"
                    android:paddingHorizontal="12dp" />

                <!-- Device Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_name"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/device_name"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Supervisor Phone -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/supervisor_phone"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etSupervisorPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/supervisor_phone"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Project Number -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROJECT NUMBER"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etProjectNumber"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Project Number (e.g. PRJ-2026-A)"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Server URL / IP -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SERVER BASE URL"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="http://192.168.1.53:8000"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Duty Shift Schedule Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDutySchedule"
            style="@style/Widget.DWEX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_modal"
            app:strokeWidth="1dp"
            app:strokeColor="@color/watchmen_border_default"
            app:cardBackgroundColor="@color/watchmen_bg_card"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DUTY SHIFT SCHEDULE"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recurring duty shift timing for official attendance"
                    android:textSize="12sp"
                    android:textColor="@color/watchmen_text_muted"
                    android:layout_marginBottom="16dp" />

                <!-- Shift Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SHIFT NAME"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etShiftName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Day Shift"
                        android:hint="e.g. Day Shift / Night Shift"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Shift Hours: Start Time & End Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Start Time -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="START TIME"
                            style="@style/TextAppearance.DWEX.SectionTitle"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/btnSelectStartTime"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_container_elevated"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/watchmen_online"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvStartTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="07:00 AM"
                                android:textColor="@color/watchmen_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- End Time -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="END TIME"
                            style="@style/TextAppearance.DWEX.SectionTitle"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/btnSelectEndTime"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_container_elevated"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/watchmen_warning"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvEndTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="07:00 PM"
                                android:textColor="@color/watchmen_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Site Timezone -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SITE TIMEZONE"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/etTimezone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Asia/Dubai"
                        android:hint="e.g. Asia/Dubai"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="@color/watchmen_text_primary"
                        android:padding="12dp"
                        android:background="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Working Days -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SCHEDULED WORKING DAYS"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDaysSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Monday to Sunday (All 7 days)"
                    android:textSize="13sp"
                    android:textColor="@color/watchmen_text_secondary"
                    android:layout_marginBottom="6dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Setup Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSetup"
            style="@style/Widget.DWEX.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_lg"
            android:text="@string/save_setup"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_check_in"
            app:iconGravity="textEnd"
            app:iconPadding="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Footer Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Configuration can be modified later in Settings"
            android:textSize="12sp"
            android:textColor="@color/watchmen_text_muted"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
