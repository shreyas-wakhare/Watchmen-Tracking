<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/watchmen_bg_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Right Server Settings Action -->
        <ImageButton
            android:id="@+id/ibServerSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_container_elevated"
            android:contentDescription="Server Settings"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="@color/watchmen_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Brand Header Section -->
        <LinearLayout
            android:id="@+id/llAuthHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/ibServerSettings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- DWEX Logo -->
            <ImageView
                android:id="@+id/ivLoginLogo"
                android:layout_width="140dp"
                android:layout_height="64dp"
                android:contentDescription="@string/dwex_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_dwex_vector" />

            <!-- Brand Badge -->
            <TextView
                android:id="@+id/tvBrandBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_brand_badge"
                android:text="DWEX SECURITY"
                android:textColor="@color/watchmen_badge_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <!-- Auth Title -->
            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Watchmen Tracker"
                android:textColor="@color/watchmen_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-bold" />

            <!-- Auth Subtitle -->
            <TextView
                android:id="@+id/tvLoginSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sign in to access Command &amp; Control"
                android:textColor="@color/watchmen_text_secondary"
                android:textSize="13sp" />

            <!-- Server Connection Status Chip -->
            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/watchmen_info"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                tools:text="Server Connected: 192.168.1.53:8000" />

        </LinearLayout>

        <!-- Form Card Container (Matching .auth-card) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginForm"
            style="@style/Widget.DWEX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="@dimen/radius_modal"
            app:strokeWidth="1dp"
            app:strokeColor="@color/watchmen_border_default"
            app:cardBackgroundColor="@color/watchmen_bg_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llAuthHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Error Banner (Matching .auth-alert) -->
                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/error_background_shape"
                    android:padding="12dp"
                    android:textColor="@color/watchmen_critical"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"
                    tools:text="Invalid email or password"
                    tools:visibility="visible" />

                <!-- Email Address Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <!-- Email Input Layout -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="user@example.com"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/watchmen_text_primary"
                        android:textSize="14sp"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <!-- Password Input Layout -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:hintEnabled="false"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/watchmen_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="••••••••"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/watchmen_text_primary"
                        android:textSize="14sp"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sign In Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.DWEX.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height_lg"
                    android:text="Sign In"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp" />

                <!-- Loading Indicator -->
                <ProgressBar
                    android:id="@+id/pbLoginLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/watchmen_primary"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigate to Signup Link -->
        <TextView
            android:id="@+id/tvGoToSignup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:padding="10dp"
            android:text="@string/no_account_prompt"
            android:textColor="@color/watchmen_primary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardLoginForm"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
