<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background_gradient">

    <!-- Center Brand Container -->
    <LinearLayout
        android:id="@+id/ll_splash_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/pb_loading_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- DWEX Logo -->
        <ImageView
            android:id="@+id/iv_app_logo"
            android:layout_width="220dp"
            android:layout_height="90dp"
            android:contentDescription="@string/dwex_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_dwex_vector"
            android:transitionName="logoTransition"
            app:tint="@null" />

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/company_name"
            android:textSize="28sp"
            android:textColor="@color/watchmen_text_primary"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.04" />

        <!-- Command & Control Subtitle -->
        <TextView
            android:id="@+id/tv_app_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Command &amp; Control Center"
            android:textSize="13sp"
            android:textColor="@color/watchmen_text_secondary"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Sleek Progress Indicator -->
    <ProgressBar
        android:id="@+id/pb_loading_indicator"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/watchmen_primary"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/tv_app_version"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Version & Copyright Footer -->
    <TextView
        android:id="@+id/tv_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="v1.0.0 | © 2026 DWEX Security"
        android:textSize="11sp"
        android:textColor="@color/watchmen_text_muted"
        android:fontFamily="sans-serif"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>