<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background_gradient"
    tools:context=".SplashScreenActivity">

    <ImageView
        android:id="@+id/iv_app_logo"
        android:layout_width="310dp"
        android:layout_height="368dp"
        android:contentDescription="@string/dwex_logo"
        android:elevation="4dp"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_dwex_vector"
        android:transitionName="logoTransition"
        app:layout_constraintBottom_toTopOf="@id/guideline_center_v"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:tint="@null" />

    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/company_name"
        android:textSize="44sp"
        android:textColor="@color/text_title_light"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        android:alpha="0.0" 
        tools:alpha="1.0"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/guideline_center_v"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/pb_loading_indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/progress_accent"
        android:layout_marginBottom="60dp"
        android:alpha="0.0"
        tools:alpha="1.0"
        app:layout_constraintBottom_toTopOf="@id/tv_app_version"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="v1.0.0 | © 2025"
        android:textSize="12sp"
        android:textColor="@color/text_white"
        android:fontFamily="sans-serif"
        android:alpha="0.4"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center_v"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.56" />

</androidx.constraintlayout.widget.ConstraintLayout>