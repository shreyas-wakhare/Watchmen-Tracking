<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watchmen_bg_primary">

    <!-- Top Header Banner -->
    <LinearLayout
        android:id="@+id/llGuideHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivGuideLogo"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:src="@drawable/logo_dwex_vector"
            android:scaleType="fitCenter"
            android:contentDescription="@string/dwex_logo" />

        <TextView
            android:id="@+id/tvGuideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/guide_title"
            android:textColor="@color/watchmen_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Operational Procedures &amp; Manual"
            android:textColor="@color/watchmen_text_muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Guide Content Card Container (Matching .saas-card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGuideContainer"
        style="@style/Widget.DWEX.Card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/watchmen_border_default"
        app:cardBackgroundColor="@color/watchmen_bg_card"
        app:layout_constraintTop_toBottomOf="@id/llGuideHeader"
        app:layout_constraintBottom_toTopOf="@id/guideDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ViewPager -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/guidePager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Swipe Dots Indicator -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/guideDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@android:color/transparent"
        app:tabIndicatorHeight="0dp"
        app:tabRippleColor="@null"
        app:tabBackground="@drawable/bg_status_dot_online"
        app:layout_constraintBottom_toTopOf="@id/btnGuideAcknowledge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Acknowledge / Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuideAcknowledge"
        style="@style/Widget.DWEX.Button"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_height_lg"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/guide_acknowledge"
        android:textSize="15sp"
        android:textStyle="bold"
        android:enabled="false"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
