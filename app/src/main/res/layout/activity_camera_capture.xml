<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watchmen_bg_primary">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Face Detection & Instruction Overlay -->
    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.watchmen.tracker.FaceOverlayView
            android:id="@+id/faceOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/ivInstruction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:alpha="0"
            app:tint="@color/watchmen_text_primary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Top Status Overlay Banner -->
    <LinearLayout
        android:id="@+id/llCameraHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_glass_card"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_dot_online" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="BIOMETRIC VERIFICATION"
            style="@style/TextAppearance.DWEX.SectionTitle" />
    </LinearLayout>

    <!-- Bottom Telemetry HUD Container -->
    <LinearLayout
        android:id="@+id/llCameraBottomHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:background="#D90B0F14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Trial Counter -->
        <TextView
            android:id="@+id/tvTrialCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="12sp"
            android:textColor="@color/watchmen_text_secondary"
            android:layout_marginBottom="8dp" />

        <!-- Confidence Progress Bar -->
        <ProgressBar
            android:id="@+id/confidenceBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="10dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressTint="@color/watchmen_online" />

        <!-- Liveness Instruction Hint -->
        <TextView
            android:id="@+id/tvLivenessHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/verifying"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/watchmen_text_primary"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Capture Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapture"
            style="@style/Widget.DWEX.Button"
            android:layout_width="200dp"
            android:layout_height="@dimen/btn_height_md"
            android:text="@string/capture"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>