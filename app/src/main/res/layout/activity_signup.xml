<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/watchmen_bg_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Brand Header Section -->
        <LinearLayout
            android:id="@+id/llSignupHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- DWEX Logo -->
            <ImageView
                android:id="@+id/ivSignupLogo"
                android:layout_width="140dp"
                android:layout_height="64dp"
                android:contentDescription="@string/dwex_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_dwex_vector" />

            <!-- Brand Badge -->
            <TextView
                android:id="@+id/tvSignupBrandBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_brand_badge"
                android:text="DWEX SECURITY"
                android:textColor="@color/watchmen_badge_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <!-- Signup Title -->
            <TextView
                android:id="@+id/tvSignupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Create Account"
                android:textColor="@color/watchmen_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-bold" />

            <!-- Signup Subtitle -->
            <TextView
                android:id="@+id/tvSignupSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Register to access Watchmen Tracker"
                android:textColor="@color/watchmen_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Form Card Container (Matching .auth-card) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSignupForm"
            style="@style/Widget.DWEX.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="@dimen/radius_modal"
            app:strokeWidth="1dp"
            app:strokeColor="@color/watchmen_border_default"
            app:cardBackgroundColor="@color/watchmen_bg_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llSignupHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Error Banner (Matching .auth-alert) -->
                <TextView
                    android:id="@+id/tvSignupError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/error_background_shape"
                    android:padding="12dp"
                    android:textColor="@color/watchmen_critical"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"
                    tools:text="An account with this email already exists."
                    tools:visibility="visible" />

                <!-- Full Name Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <!-- Full Name Input Layout -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFullName"
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="John Doe"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/watchmen_text_primary"
                        android:textSize="14sp"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email Address Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <!-- Email Input Layout -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSignupEmail"
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSignupEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="user@example.com"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/watchmen_text_primary"
                        android:textSize="14sp"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <!-- Password Input Layout -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSignupPassword"
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/watchmen_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSignupPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="••••••••"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/watchmen_text_primary"
                        android:textSize="14sp"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIRM PASSWORD"
                    style="@style/TextAppearance.DWEX.SectionTitle"
                    android:layout_marginBottom="6dp" />

                <!-- Confirm Password Input Layout -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    style="@style/Widget.DWEX.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:hintEnabled="false"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/watchmen_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="••••••••"
                        android:textColorHint="@color/watchmen_text_muted"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/watchmen_text_primary"
                        android:textSize="14sp"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Create Account Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignup"
                    style="@style/Widget.DWEX.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height_lg"
                    android:text="Create Account"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp" />

                <!-- Loading Indicator -->
                <ProgressBar
                    android:id="@+id/pbSignupLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/watchmen_primary"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigate to Login Link -->
        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:padding="10dp"
            android:text="@string/already_have_account_prompt"
            android:textColor="@color/watchmen_primary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSignupForm"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
