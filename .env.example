# ============================================================
# WATCHMEN TRACKER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in real secrets for local dev/prod.
# NEVER commit the actual .env file containing real secrets to Git.
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL Required)
# ------------------------------------------------------------
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/watchmen_tracker

# ------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------
# Secret key used for signing JWT access tokens (Must be at least 32 characters long)
JWT_SECRET_KEY=your_secure_jwt_secret_key_change_me_in_production_32chars

# JWT Signing Algorithm (Allowed: HS256)
JWT_ALGORITHM=HS256

# Access Token Expiration in Minutes (Default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token Expiration in Days (Default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------
# 3. SERVER CONFIGURATION
# ------------------------------------------------------------
# Server Port (Default: 8000)
PORT=8000
